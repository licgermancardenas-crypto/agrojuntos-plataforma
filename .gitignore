# Entornos virtuales
.venv/
venv/
__pycache__/
*.pyc

# Datos crudos del mapeo territorial: 1.6 GB, publicos y reproducibles
# con los scripts de descarga. (No usar patrones tipo AGRO*/ : git en
# Windows los aplica sin distinguir mayusculas y se traga
# agro_insumos_pe_data/, que si debe versionarse.)
/data/
*.pbf

# Confidencial: libro de ventas y cotizaciones de AgroJuntos.
# No va a un repositorio publico.
ventas_*.csv
*cotizacion*

# El archivo historico de aduanas: crece unos 40 MB por semana y git conserva
# cada version para siempre. Lo que se versiona es el manifiesto —que semanas
# hay, con su sha256— y no los ZIP. Si hace falta compartirlos, van a Releases.
data/aduanas_hist/

# La tabla de operaciones de importacion: 11 MB hoy, mas de 50 a cinco anos, y
# se regenera entera desde los ZIP del manifiesto con build_import_historico.py
# + build_import_clasificar.py. Se versionan los agregados, que son lo que el
# sitio lee, y el manifiesto, que permite comprobar que los ZIP son los mismos.
data/importaciones/processed/operaciones*.csv
